# Base URL of the RealGrowth API, including the trailing /api prefix.
# Copy this file to `.env` for local development and adjust as needed.
#
# The typed client falls back to a relative "/api" if this is unset, which only
# works when something proxies /api to the backend (e.g. the Vite dev server or
# a reverse proxy). For a static deployment, set this to the API's full URL.

# Local development — backend running on port 8000:
VITE_API_URL=http://localhost:8000/api

# Production example (Render): https://realgrowth-api.onrender.com/api
